{
  "name": "faucet-backend",
  "version": "1.0.0",
  "description": "Backend services use for faucet application (NEM / Symbol)",
  "type": "module",
  "scripts": {
    "start": "node -r dotenv/config src/server.js",
    "dev": "nodemon -r dotenv/config src/server.js",
    "lint": "eslint src/ test/",
    "lint:fix": "eslint src/ test/ --fix",
    "test": "TZ=utc mocha --full-trace --recursive test --exit -r dotenv/config dotenv_config_path=./.env.test",
    "test:jenkins": "c8 --require mocha --no-clean --reporter=lcov npm run test",
    "version": "echo $npm_package_version"
  },
  "author": "Symbol Contributors <contributors@symbol.dev>",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "axios": "^1.17.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "jsonwebtoken": "^9.0.3",
    "sqlite3": "^6.0.1",
    "symbol-sdk": "^3.3.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "assert-plus": "^1.0.0",
    "axios-mock-adapter": "^2.1.0",
    "c8": "^11.0.0",
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.2",
    "eslint": "^10.7.0",
    "eslint-config-airbnb": "^19.0.4",
    "mocha": "^11.7.6",
    "nodemon": "^3.1.14",
    "sinon": "^22.0.0",
    "sinon-chai": "^4.0.1",
    "supertest": "^7.2.2"
  }
}
