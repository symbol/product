# Copy to `.env` and fill in the values for your deployment.
# See README.md > Environment Variables for naming and visibility rules.

# Build-time variant selector. It drives theme and module selection, so it must match the image build.
NEXT_PUBLIC_EXPLORER_VARIANT=nem

# --- Common ---
# Explorer REST API endpoint.
PUBLIC_API_BASE_URL=https://testnet.nem.fyi/api/nem
# Network request timeout in ms
PUBLIC_REQUEST_TIMEOUT=15000
# Network identifier, `testnet` | `mainnet`.
PUBLIC_NETWORK_IDENTIFIER=testnet
PUBLIC_NATIVE_MOSAIC_ID=nem.xem
PUBLIC_NATIVE_MOSAIC_TICKER=XEM
PUBLIC_NATIVE_MOSAIC_DIVISIBILITY=6
PUBLIC_SOCIAL_URL_TWITTER=https://twitter.com/NEMofficial
PUBLIC_SOCIAL_URL_GITHUB=https://github.com/nemproject
PUBLIC_SOCIAL_URL_DISCORD=https://discord.gg/NMA9YQ55td
PUBLIC_FOOTER_URL_DOCS=https://docs.nem.io
PUBLIC_FOOTER_URL_TECHNICAL_REFERENCE=https://docs.nem.io/pages/Whitepapers/NEM_techRef.pdf
PUBLIC_FOOTER_URL_FAUCET=https://testnet.nem.tools
PUBLIC_FOOTER_URL_SUPERNODE_PROGRAM=https://nem.io/supernode
PUBLIC_NODEWATCH_URL=https://nodewatch.symbol.tools/testnet

# --- NEM variant ---
PUBLIC_NEM_BLOCKCHAIN_UNWIND_LIMIT=360
PUBLIC_NEM_HISTORICAL_PRICE_URL=https://api.coingecko.com/api/v3/coins/nem/history
PUBLIC_NEM_SUPERNODE_API_URL=https://nem.io/supernode/api
PUBLIC_NEM_MARKET_DATA_URL=https://api.coingecko.com/api/v3/simple/price
