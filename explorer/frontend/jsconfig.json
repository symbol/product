{
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@/app/api/*": ["api/*"],
			"@/app/components/*": ["components/*"],
			"@/app/config": ["config/index.js"],
			"@/app/constants": ["constants/index.js"],
			"@/app/contexts/*": ["contexts/*"],
			"@/app/pages/*": ["pages/*"],
			"@/app/public/*": ["public/*"],
			"@/app/styles/*": ["styles/*"],
			"@/app/utils": ["utils"],
			"@/app/utils/*": ["utils/*"],
			"@/app/variants/*": ["variants/*"],
			"@/app/active-variant/*": ["variants/nem/*"]
		}
	},
	"exclude": ["**/node_modules/*", "**/build/*", "**/scripts/*"]
}
