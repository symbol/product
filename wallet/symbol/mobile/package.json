{
  "name": "SymbolMobileWallet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "react-native start",
    "build:js:symbol": "react-native bundle --entry-file index.js --bundle-output ./bundle.js --resolver-option brand=symbol",
    "build:js:nem": "react-native bundle --entry-file index.js --bundle-output ./bundle.js --resolver-option brand=nem",
    "build:android:dev:symbol": "react-native run-android --mode symbolDebug",
    "build:android:dev:nem": "react-native run-android --mode nemDebug --appId com.thesymbolsyndicate.nemwallet",
    "build:android:prod:symbol": "cd ./android && ./gradlew assembleSymbolRelease",
    "build:android:prod:nem": "cd ./android && ./gradlew assembleNemRelease",
    "build:ios:dev:symbol": "react-native run-ios --scheme SymbolMobileWallet",
    "build:ios:dev:nem": "react-native run-ios --scheme NemMobileWallet",
    "build:ios:prod:symbol": "react-native run-ios --mode Release --scheme SymbolMobileWallet",
    "build:ios:prod:nem": "react-native run-ios --mode Release --scheme NemMobileWallet",
    "connect:android": "adb reverse tcp:8081 tcp:8081",
    "test": "jest",
    "test:cov": "c8 --reporter=lcov --reporter=text --report-dir=coverage npm run test",
    "test:cov:ci": "NODE_OPTIONS='--max-old-space-size=4096' c8 --reporter=lcov --reporter=text --report-dir=coverage bash -c 'npm run test -- --shard=1/3 --testTimeout=30000 && npm run test -- --shard=2/3 --testTimeout=30000 && npm run test -- --shard=3/3 --testTimeout=30000'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix --color"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "bip39": "^3.1.0",
    "crypto-js": "^4.2.0",
    "ethers": "^6.15.0",
    "events": "^3.3.0",
    "i18n-js": "^4.5.3",
    "lodash": "^4.18.1",
    "moment": "^2.31.0",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-crypto": "^2.2.0",
    "react-native-draggable-flatlist": "^4.0.0",
    "react-native-encrypted-storage": "^4.0.3",
    "react-native-flash-message": "^0.4.2",
    "react-native-gesture-handler": "^2.29.1",
    "react-native-keychain": "^8.1.1",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-permissions": "^3.6.1",
    "react-native-reanimated": "~4.6.0",
    "react-native-reorderable-list": "^0.18.1",
    "react-native-safe-area-context": "~5.10.0",
    "react-native-screens": "~4.28.0",
    "react-native-smooth-slider": "^1.3.6",
    "react-native-vision-camera": "^4.7.3",
    "react-native-worklets": "~0.12.2",
    "symbol-crypto-wasm-web": "^0.1.1",
    "symbol-sdk": "3.3.2",
    "wallet-common-core": "file:../../common/core",
    "wallet-common-ethereum": "file:../../common/ethereum",
    "wallet-common-nem": "file:../../common/nem",
    "wallet-common-symbol": "file:../../common/symbol",
    "wallet-common-transport": "file:../../common/transport"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@eslint/js": "^10.0.1",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@sinonjs/text-encoding": "^0.7.3",
    "@testing-library/react-native": "^13.3.3",
    "assert": "^2.1.0",
    "babel-jest": "^30.5.2",
    "babel-plugin-module-resolver": "^5.0.3",
    "browserify-zlib": "^0.2.0",
    "buffer": "^6.0.3",
    "c8": "^10.1.3",
    "eslint": "^10.11.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^64.5.4",
    "globals": "^17.11.0",
    "jest": "^30.5.2",
    "path-browserify": "^1.0.1",
    "prettier": "^3.9.6",
    "process": "^0.11.10",
    "react-native-randombytes": "^3.6.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-test-renderer": "19.2.3",
    "rn-nodeify": "^10.3.0",
    "stream-browserify": "^3.0.0",
    "util": "^0.12.5"
  },
  "engines": {
    "node": ">=24"
  },
  "codegenConfig": {
    "name": "SymbolWalletSpec",
    "type": "modules",
    "jsSrcsDir": "specs",
    "android": {
      "javaPackageName": "com.thesymbolsyndicate.symbolwallet.specs"
    }
  },
  "overrides": {
    "d3-color": "3.1.0",
    "semver": "7.5.3",
    "react-native-vector-icons": "10.2.0"
  }
}
